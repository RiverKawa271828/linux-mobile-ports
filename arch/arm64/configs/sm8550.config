# Qualcomm Snapdragon 8 Gen 2 (SM8550) config fragment
#
# Generate a focused configuration with:
#   make ARCH=arm64 defconfig sm8550.config

CONFIG_LOCALVERSION="-sm8550"
CONFIG_COMPILE_TEST=n
CONFIG_ARCH_QCOM=y
CONFIG_NR_CPUS=8

# Meizu 20 Infinity platform
CONFIG_PINCTRL_SM8550=y
CONFIG_SM_GCC_8550=y
CONFIG_SM_DISPCC_8550=y
CONFIG_SM_GPUCC_8550=y
CONFIG_SM_TCSRCC_8550=y
CONFIG_INTERCONNECT_QCOM_SM8550=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_SCSI_UFS_QCOM=y

# Display
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_NT37290_BOE=y

# USB and Type-C providers must be available before deferred probing ends
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_CONFIGFS=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_TYPEC_MUX_FSA4480=y
CONFIG_TYPEC_MUX_NB7VPQ904M=y
CONFIG_TYPEC_DP_ALTMODE=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y

# Device peripherals
CONFIG_ATH12K=m
CONFIG_BATTERY_QCOM_BATTMGR=m
CONFIG_INPUT_QCOM_HV_HAPTICS=m
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_CORE=m
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_I2C=m
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_SPI=m
CONFIG_SND_SOC_TFA98XX=m

# Preserve boot diagnostics without requiring modules
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_COMPRESS=y

# Exclude non-Qualcomm arm64 platforms. Their dependent clock, pinctrl,
# interconnect, IOMMU, media and peripheral drivers are removed by Kconfig.
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_AIROHA=n
