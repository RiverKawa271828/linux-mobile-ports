// SPDX-License-Identifier: GPL-2.0-only
/*
 * Device Tree Source for Meizu 20 (m2381, SM8550/Kalama)
 * Copyright (c) 2026 Meizu Technologies
 *
 * factory-first 重建 v2（2026-10-03，DT 原厂化会话②）：
 * 本文件按 2026-10-04 用户拍板方针「本机原厂件为唯一事实源」整文件重建，
 * 取代 inf（Meizu 20 Infinity）派生旧版。逐节点出处与分类 =
 * meizu20-m1/dts/factory-first/LEDGER.md（台账，常驻维护——改此文件必须同步改台账）；
 * 原厂真值 = meizu20-m1/dts/factory-first/corpus/（vendor_boot base DTB + dtbo
 * entry9 + runtime FDT 三源，互验记录见同目录 README 与 reports/）。
 * 出处缩写：entry9 = dtbo entry9（本机生效 overlay）；RT = runtime FDT（ABL 后）。
 */
// SPDX-License-Identifier: BSD-3-Clause
/*
 * Copyright (c) 2025, Teguh Sobirin.
 */

/dts-v1/;
#include <dt-bindings/leds/common.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include <dt-bindings/input/qcom,hv-haptics.h>
#include "sm8550.dtsi"
#include "pm8010.dtsi"
#include "pm8550.dtsi"
#include "pm8550b.dtsi"
#define PMK8550VE_SID 5
#include "pm8550ve.dtsi"
#include "pm8550vs.dtsi"
#include "pmk8550.dtsi"


/delete-node/ &rmtfs_mem;

/* sm8550.dtsi ships a placeholder memory node (reg size 0) and expects "the
 * bootloader to fill in the size".  We boot with a bare arm64 jump, so nobody
 * fills it - and with no /memory at all memblock is empty and paging_init()
 * panics with "Failed to allocate page table page".  The ranges below are
 * copied verbatim from this device's own bootloader-filled tree (stock
 * /sys/firmware/fdt, harvest 2026-09-21 = RT): the stock kernel booted with
 * exactly these values, so they are the platform's authoritative "OS memory".
 */
/delete-node/ &{/memory@a0000000};

/ {
	chassis-type = "handset";

	model = "Meizu 20 (m2381)";
	compatible = "meizu,meizu-20", "qcom,sm8550";

	/* RT: /memory 与本表同源（runtime FDT 即 boot 后地面真值）【D：裸跳需要】 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0xe00000>,
		      <0x00 0x811d0000 0x00 0x56e30000>,
		      <0x00 0xd8140000 0x00 0x20000>,
		      <0x00 0xd8800000 0x00 0x0>,
		      <0x00 0xe3bb0000 0x00 0x1c450000>,
		      <0x08 0x80000000 0x00 0x38700000>,
		      <0x08 0xc0000000 0x01 0x40000000>,
		      <0x0a 0x00 0x02 0x00>;
	};

	aliases {
		serial0 = &uart7;
		serial1 = &uart14;
	};

	/* CS35L45 VP 供电：stock 为无 GPIO 常开 fixed regulator（代表 VSYS 轨）
	 * 【D：主线 cs35l45 binding 需要 vdd-batt，stock 走不同框架】 */
	audio_vsys: regulator-audio-vsys {
		compatible = "regulator-fixed";
		regulator-name = "audio_vsys";
		regulator-always-on;
		regulator-boot-on;
	};

	wcd938x: audio-codec {
		compatible = "qcom,wcd9385-codec";
		/* reset-gpios=108 与 CS35L45 RCV 的 stock reset 同一网络（见 &i2c10 注），
		 * mainline 由本节点独占持有。
		 * 【A：RT wcd938x_reset_active/sleep = gpio108 ds16】*/
		pinctrl-names = "default";
		pinctrl-0 = <&wcd_default>;

		/* 【B：RT wcd938x-codec qcom,cdc-micbias1..4-mv 全部 0x708=1800mV；
		 * 旧 micbias2=2.7V 为 inf 派生偏差。音频 T3 假设（全 2.75V）与原厂
		 * 相反，随本行作废。2026-10-03 重建。】 */
		qcom,micbias1-microvolt = <1800000>;
		qcom,micbias2-microvolt = <1800000>;
		qcom,micbias3-microvolt = <1800000>;
		qcom,micbias4-microvolt = <1800000>;
		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
		qcom,rx-device = <&wcd_rx>;
		qcom,tx-device = <&wcd_tx>;

		reset-gpios = <&tlmm 108 GPIO_ACTIVE_LOW>;

		vdd-buck-supply = <&vreg_l15b_1p8>;
		vdd-rxtx-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l15b_1p8>;
		vdd-mic-bias-supply = <&vreg_bob1>;

		#sound-dai-cells = <1>;
	};

	chosen {
		/*
		 * R23bi: no stdout-path on purpose.  The kernel console must become
		 * tty0/fbcon (fed by our glue's sysfb_primary_display fill + the
		 * earlycon=efifb that is already baked into CONFIG_CMDLINE); naming a
		 * serial here would make it the preferred console and the framebuffer
		 * console would stay disabled.
		 * 【D：UEFI 链控制台形态】
		 */
	};

	/* 【A：RT key_vol_up_default = pm8550 gpio6 input-enable pull-up】 */
	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&volume_up_n>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			debounce-interval = <15>;
			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			linux,can-disable;
			wakeup-source;
		};
	};

	pmic-glink {
		compatible = "meizu,meizu-20-inf-pmic-glink",
			     "qcom,sm8550-pmic-glink", "qcom,pmic-glink";
		#address-cells = <1>;
		#size-cells = <0>;
		orientation-gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;

		/*
		 * The board has no wireless charging hardware: the firmware
		 * never answers the wireless supply property requests, so
		 * skip those power supplies entirely.
		 * 【D：功耗战役产物，stock 树无此概念】
		 */
		qcom,no-wireless-charging;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					pmic_glink_hs_in: endpoint {
						remote-endpoint = <&usb_1_dwc3_hs>;
					};
				};

				port@1 {
					reg = <1>;

					pmic_glink_ss_in: endpoint {
						remote-endpoint = <&redriver_ss_out>;
					};
				};

				port@2 {
					reg = <2>;

					pmic_glink_sbu: endpoint {
						remote-endpoint = <&fsa4480_sbu_mux>;
					};
				};
			};
		};
	};

	reserved-memory {
		/*
		 * Fixed firmware reservations below come from the SoC dtsi
		 * (sm8550.dtsi) plus these board additions, all cross-checked
		 * against the stock m2381 base DTB（2026-09-30 审计；本轮 corpus =
		 * 同一 base，复核入口 = factory-first/corpus/vboot_a.fdt0.dts）:
		 *  - chipinfo@81cf4000: stock-declared, no kernel consumer, kept
		 *    verbatim;
		 *  - hwfence-shbuf: stock is 0x2dd000, SoC dtsi only reserves
		 *    0x279000 - this node intentionally overrides it;
		 *  - llcc_lpi@ff800000: stock-declared, absent from the SoC dtsi;
		 *  - rmtfs@e7900000, splash@b8000000, ramoops@a5100000: board-
		 *    managed carveouts.
		 * 【待捕：全表逐项对账 = 板级分片（台账预留行）；现行值 9-30 审计过】
		 */
		ramoops@a5100000 {
			compatible = "ramoops";
			reg = <0 0xa5100000 0 0x200000>;
			console-size = <0x7d800>;
		};

		chipinfo_mem: chipinfo-region@81cf4000 {
			reg = <0 0x81cf4000 0 0x1000>;
			no-map;
		};

		hwfence_shbuf: hwfence-shbuf-region@e6440000 {
			reg = <0 0xe6440000 0 0x2dd000>;
			no-map;
		};

		llcc_lpi_mem: llcc_lpi_region@ff800000 {
			reg = <0 0xff800000 0 0x600000>;
			no-map;
		};

		rmtfs_mem: rmtfs-region@e7900000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x0 0xe7900000 0x0 0x280000>;
			no-map;

			qcom,client-id = <1>;
			qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
		};

		splash_region: splash-region@b8000000 {
			reg = <0x0 0xb8000000 0x0 0x2b00000>;
			iommu-addresses = <&mdss 0x0 0xb8000000 0x0 0x2b00000>;
			no-map;
		};

		/*
		 * ADSP fastrpc remote heap: stock m2381 declares the same
		 * 12MB reusable pool (adsp_heap_region) and assigns the
		 * static-PD heap to {LPASS 0x16, ADSP_HEAP 0x25} -- same
		 * recipe as upstream sm8250/sm8750/kodiak.
		 */
		adsp_rpc_remote_heap_mem: adsp-rpc-remote-heap {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x0 0x80000000 0x0 0x80000000>;
			reusable;
			alignment = <0x0 0x400000>;
			size = <0x0 0xc00000>;
		};
	};


	sound {
		compatible = "meizu,meizu-20-inf-sndcard",
			     "qcom,sm8550-sndcard", "qcom,sm8450-sndcard";
		pinctrl-0 = <&i2s1_default>;
		pinctrl-names = "default";

		model = "MEIZU20Inf";
		audio-routing = "IN1_HPHL", "HPHL_OUT",
				"IN2_HPHR", "HPHR_OUT",
				"AMIC1", "MIC BIAS1",
				"AMIC2", "MIC BIAS2",
				"AMIC3", "MIC BIAS3",
				"AMIC4", "MIC BIAS3",
				"AMIC5", "MIC BIAS4",
				"TX SWR_INPUT0", "ADC1_OUTPUT",
				"TX SWR_INPUT1", "ADC2_OUTPUT",
				"TX SWR_INPUT0", "ADC3_OUTPUT",
				"TX SWR_INPUT1", "ADC4_OUTPUT";
		wcd-playback-dai-link {
			link-name = "WCD Playback";
			cpu {
				sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
			};
			codec {
				sound-dai = <&wcd938x 0>, <&swr1 0>, <&lpass_rxmacro 0>;
			};
			platform {
				sound-dai = <&q6apm>;
			};
		};

		wcd-capture-dai-link {
			link-name = "WCD Capture";
			cpu {
				sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
			};
			codec {
				sound-dai = <&wcd938x 1>, <&swr2 0>, <&lpass_txmacro 0>;
			};
			platform {
				sound-dai = <&q6apm>;
			};
		};

		secondary-i2s-dai-link {
			link-name = "Secondary MI2S Playback";

			cpu {
				sound-dai = <&q6apmbedai SECONDARY_MI2S_RX>;
			};

			platform {
				sound-dai = <&q6apm>;
			};

			codec {
				sound-dai = <&cs35l45_rcv>, <&cs35l45_spk>;
			};
		};

		/*
		 * No displayport-0-dai-link: mdss_dp0 is disabled on m2381
		 * (2026-09-28 panel bring-up, see &mdss_dp0 above). A dai-link
		 * referencing a disabled codec leaves that ASoC component
		 * permanently absent, and the sm8550-sndcard machine driver
		 * silently defers forever = no sound card at all.
		 */
	};

	vph_pwr: regulator-vph-pwr {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;

		regulator-always-on;
		regulator-boot-on;
	};

	/* ★显示供电三轨（factory-first 重建 2026-10-03，原厂出处见各行）：
	 * stock dsi-display-primary 的 vddio/vdd/vci 全部为 GPIO 门控轨
	 * （display_gpio_regulator@0/1/2，qti-regulator-fixed），不是 RPMH LDO。
	 * 门后物理轨电压由 PMIC 固件决定，节点内电压值 = stock 声明（文档用途）；
	 * r6/r7 活体实测：vddio 1.8V / vdd 1.2V / vci 3.0V——与 stock 声明不完全一致，
	 * 电压值不改物理轨，仅入台账备查。
	 * avdd（stock 供电表 4.6-6.0V，无人引用）：原厂不经 DT 管理该轨（PMIC 上电
	 * 常在），主线驱动 bulk 只取 vddio/vdd/vci ⇒ 不建节点（旧 avdd 5.5V@gpio11
	 * 死配线节点删除——gpio11 的原厂活角色是 vddi 使能）。
	 * 旧 inf 三轨（l12b/l11b/l13b）从 panel 节点摘除；LDO 本体保留在
	 * regulators-0（其他消费者在用）。 */

	/* vddio：RT display_gpio_regulator@0 "display_panel_vddi"，pm8550 gpio11，
	 * 1.8V，boot-on，enable-active-high，ramp 0xe9=233us，
	 * pinctrl display_panel_vddi_default（power-source 1, output-high） */
	panel_vddio: regulator-panel-vddio {
		compatible = "regulator-fixed";
		regulator-name = "display_panel_vddio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&pm8550_gpios 11 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		pinctrl-0 = <&display_panel_vddio_default>;
		pinctrl-names = "default";
		startup-delay-us = <233>;
		regulator-boot-on;
	};

	/* vdd：RT display_gpio_regulator@1 "display_panel_vddr"，pm8550b gpio5，
	 * 1.8V，boot-on，形态同 vddio */
	panel_vdd: regulator-panel-vdd {
		compatible = "regulator-fixed";
		regulator-name = "display_panel_vdd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&pm8550b_gpios 5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		pinctrl-0 = <&display_panel_vdd_default>;
		pinctrl-names = "default";
		startup-delay-us = <233>;
		regulator-boot-on;
	};

	/* vci：RT display_gpio_regulator@2 "display_panel_vci"，pm8550 gpio1，
	 * 1.8V（声明），boot-on，pinctrl power-source 0（其余两轨为 1） */
	panel_vci: regulator-panel-vci {
		compatible = "regulator-fixed";
		regulator-name = "display_panel_vci";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&pm8550_gpios 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		pinctrl-0 = <&display_panel_vci_default>;
		pinctrl-names = "default";
		startup-delay-us = <233>;
		regulator-boot-on;
	};

	/* 【A：RT wlan/bt enable pinctrl = gpio80/81；主线 wcn7850-pmu 形态】 */
	wcn7850-pmu {
		compatible = "qcom,wcn7850-pmu";

		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en>, <&bt_default>, <&pmk8550_sleep_clk>;

		wlan-enable-gpios = <&tlmm 80 GPIO_ACTIVE_HIGH>;
        bt-enable-gpios = <&tlmm 81 GPIO_ACTIVE_HIGH>;

		vdd-supply = <&vreg_s5g_0p8>;
		vddio-supply = <&vreg_l15b_1p8>;
		vddaon-supply = <&vreg_s2g_0p8>;
		vdddig-supply = <&vreg_s4e_0p95>;
		vddrfa1p2-supply = <&vreg_s4g_1p3>;
		vddrfa1p8-supply = <&vreg_s6g_1p8>;

		regulators {
			vreg_pmu_rfa_cmn: ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn";
			};

			vreg_pmu_aon_0p59: ldo1 {
				regulator-name = "vreg_pmu_aon_0p59";
			};

			vreg_pmu_wlcx_0p8: ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
			};

			vreg_pmu_wlmx_0p85: ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p85";
			};

			vreg_pmu_btcmx_0p85: ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p85";
			};

			vreg_pmu_rfa_0p8: ldo5 {
				regulator-name = "vreg_pmu_rfa_0p8";
			};

			vreg_pmu_rfa_1p2: ldo6 {
				regulator-name = "vreg_pmu_rfa_1p2";
			};

			vreg_pmu_rfa_1p8: ldo7 {
				regulator-name = "vreg_pmu_rfa_1p8";
			};

			vreg_pmu_pcie_0p9: ldo8 {
				regulator-name = "vreg_pmu_pcie_0p9";
			};

			vreg_pmu_pcie_1p8: ldo9 {
				regulator-name = "vreg_pmu_pcie_1p8";
			};
		};
	};
};

/* RPMH 轨位族：值族沿用 inf 派生（设备现役 20+ 天全子系统实跑验证），
 * **原厂对账 = 未做**（下游 RPMH 轨不在 DT，待板级分片按 RT regulator 节点
 * 逐轨对账，台账标「待捕」）。改轨前先看台账。 */
&apps_rsc {
	regulators-0 {
		compatible = "qcom,pm8550-rpmh-regulators";
		qcom,pmic-id = "b";

		vdd-bob1-supply = <&vph_pwr>;
		vdd-bob2-supply = <&vph_pwr>;
		vdd-l1-l4-l10-supply = <&vreg_s6g_1p8>;
		vdd-l2-l13-l14-supply = <&vreg_bob1>;
		vdd-l3-supply = <&vreg_s4g_1p3>;
		vdd-l5-l16-supply = <&vreg_bob1>;
		vdd-l6-l7-supply = <&vreg_bob1>;
		vdd-l8-l9-supply = <&vreg_bob1>;
		vdd-l11-supply = <&vreg_s4g_1p3>;
		vdd-l12-supply = <&vreg_s6g_1p8>;
		vdd-l15-supply = <&vreg_s6g_1p8>;
		vdd-l17-supply = <&vreg_bob2>;

		vreg_bob1: bob1 {
			regulator-name = "vreg_bob1";
			regulator-min-microvolt = <3296000>;
			regulator-max-microvolt = <3960000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_bob2: bob2 {
			regulator-name = "vreg_bob2";
			regulator-min-microvolt = <2720000>;
			regulator-max-microvolt = <3960000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2b_3p0: ldo2 {
			regulator-name = "vreg_l2b_3p0";
			regulator-min-microvolt = <3008000>;
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
					   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l5b_3p1: ldo5 {
			regulator-name = "vreg_l5b_3p1";
			regulator-min-microvolt = <3104000>;
			regulator-max-microvolt = <3104000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
					   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l6b_1p8: ldo6 {
			regulator-name = "vreg_l6b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
					   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l7b_1p8: ldo7 {
			regulator-name = "vreg_l7b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l8b_1p8: ldo8 {
			regulator-name = "vreg_l8b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
					   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l9b_2p9: ldo9 {
			regulator-name = "vreg_l9b_2p9";
			regulator-min-microvolt = <2960000>;
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
					   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l11b_1p1: ldo11 {
			regulator-name = "vreg_l11b_1p1";
			regulator-min-microvolt = <1100000>;
			regulator-max-microvolt = <1504000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
