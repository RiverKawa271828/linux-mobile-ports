&crypto {
	/* QCE cannot be used safely while it is shared with the secure world. */
	status = "disabled";
};

&gpi_dma1 {
	status = "okay";
};

&gpi_dma2 {
	status = "okay";
};

&gpu {
	status = "okay";

	zap-shader {
		firmware-name = "qcom/sm8550/a740_zap.mbn";
	};
};

&ipa {
	firmware-name = "qcom/sm8550/meizu/ipa_fws.mbn";
	status = "okay";
};

&i2c0 {
	clock-frequency = <400000>;
	status = "okay";
};

/* 【A：entry9 qcom,i2c-touch-active="goodix,gt9916" + goodix-berlin@5d，
 * reset 0x18=24 / irq 0x19=25、1080×2400 全同】 */
&i2c4 {
	clock-frequency = <400000>;
	status = "okay";

	touchscreen@5d {
		compatible = "goodix,gt9916";
		reg = <0x5d>;

		pinctrl-0 = <&ts_irq>, <&ts_reset>;
		pinctrl-names = "default";

		interrupt-parent = <&tlmm>;
		interrupts = <25 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;

		/* 【B 待捕：stock avdd = humu L9B ~2.96V（我方 l14b 3.2V，触控在用）】 */
		avdd-supply = <&vreg_l14b_3p2>;
		vddio-supply = <&vreg_l12b_1p8>;

		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;
	};
};

&i2c_master_hub_0 {
	status = "okay";
};

/* m2381 扬声器/听筒 = Cirrus CS35L45 ×2（stock dtbo + 运行时 FDT + vendor wmfw 三路实锤；
 * 旧 tfa9875@34/35 为 silime inf dts 虚构，随 &i2c8 使能块一并删除——880000 总线无真实器件）。
 * 【A：RT cs35l45@30=dsp-part-name cs35l45-rcv / @31=cs35l45-spk】 */
&qupv3_id_1 {
	status = "okay";
};

&i2c10 {
	clock-frequency = <400000>;
	status = "okay";

	cs35l45_rcv: cs35l45@30 {
		compatible = "cirrus,cs35l45";
		reg = <0x30>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "RCV";

		/*
		 * stock reset-gpios = <&tlmm 108>（RT cs35l45-rcv 节点），与 wcd938x
		 * reset 同一网络（stock 两侧都写在各自节点，靠 Android 端 wcd 平台节点
		 * disabled 规避双持）。mainline 只让 wcd938x 持有该线：wcd probe 先行
		 * 复位/释放，RCV 随之出复位，故省略。
		 */
		vdd-a-supply = <&vreg_l15b_1p8>;
		vdd-batt-supply = <&audio_vsys>;
	};

	cs35l45_spk: cs35l45@31 {
		compatible = "cirrus,cs35l45";
		reg = <0x31>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "SPK";

		vdd-a-supply = <&vreg_l15b_1p8>;
		vdd-batt-supply = <&audio_vsys>;
	};
};

&i2c_hub_2 {
	clock-frequency = <400000>;
	status = "okay";

	/**
    fsa4480@42
    rtc6226@64
    onnn redriver@1c
    **/
    typec-retimer@1c {
		compatible = "onnn,nb7vpq904m";
		reg = <0x1c>;

		vcc-supply = <&vreg_l15b_1p8>;

		retimer-switch;
		orientation-switch;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				redriver_ss_out: endpoint {
					remote-endpoint = <&pmic_glink_ss_in>;
				};
			};

			port@1 {
				reg = <1>;

				redriver_ss_in: endpoint {
					data-lanes = <3 2 1 0>;
					remote-endpoint = <&usb_dp_qmpphy_out>;
				};
			};
		};
	};

    typec-mux@42 {
		compatible = "fcs,fsa4480";
		reg = <0x42>;

		vcc-supply = <&vreg_bob1>;

		mode-switch;
		orientation-switch;

		port {
			fsa4480_sbu_mux: endpoint {
				remote-endpoint = <&pmic_glink_sbu>;
			};
		};
	};
};

&iris {
	status = "okay";
};

&lpass_vamacro {
	qcom,dmic-sample-rate = <4800000>;
};

&lpass_wsamacro {
	status = "disabled";
};

&mdss {
	memory-region = <&splash_region>;
	status = "okay";
};

&mdss_dp0 {
	/* m2381: DP 组件 deferred 拖死 DRM 组件等待 ⇒ DSI/panel 永不 probe;
	 * 本机无 DP 用例,禁用(2026-09-28 面板 bring-up)。stock 有完整 DP 树
	 * （entry 间差异项），复用等 dp0 冲突面调研后再议。 */
	status = "disabled";
};

/* ★显示分片①（factory-first 重建 2026-10-03）：
 * - reset = TLMM **133**（原厂双证：entry9 qcom,platform-reset-gpio=0x85 + RT 同值；
 *   pinctrl sde_dsi_active/suspend 同脚。旧 205 为 inf 派生错值；210 系 UFS 复位脚，
 *   硬定律#9「Mu 写 GPIO210 即死」= 写 UFS 复位线，历史自洽）。
 * - 供电三轨 = GPIO 门控轨（见文件头 panel_vddio/vdd/vci），旧 LDO 三轨摘除。
 * - TE/pinctrl/时序面 A 类不变：te-source mdp_vsync_p、sde_te gpio86；驱动
 *   120Hz 模式 porch 50/16/50+20/4/12 与 entry9 timing@0 同（htotal 1196 自洽）。
 * - 驱动时序/序列与 stock 120Hz 档逐字节同（FINDINGS 三源对账）；bitclk 1094 =
 *   entry9 panel-clockrate 四档全值。 */
&mdss_dsi0 {
	vdda-supply = <&vreg_l3e_1p2>;
	status = "okay";

	display_panel: panel@0 {
		/* m2381: BOE AMOLED FHD+ 1080x2400 cmd+DSC, PanelID B5011A05
		 * （DDIC = Novatek 族，DSIDSCProfileID=0xB=主机不发 PPS 特类）。
		 * 驱动 = 自写 panel-boe-meizu20.c（TODO(m2381-panel)：mainline 尚无此面板），
		 * 节点保持主线形态，输入按原厂纠正（本注释块即出处）。
		 * 真值表 = factory-first/reports/PANEL-GROUND-TRUTH.md。 */
		compatible = "boe,meizu20-amoled-fhd";
		reg = <0>;

		pinctrl-0 = <&sde_dsi_active>, <&sde_te_active>;
		pinctrl-1 = <&sde_dsi_suspend>, <&sde_te_suspend>;
		pinctrl-names = "default", "sleep";

		vddio-supply = <&panel_vddio>;
		vdd-supply = <&panel_vdd>;
		vci-supply = <&panel_vci>;

		reset-gpios = <&tlmm 133 GPIO_ACTIVE_LOW>;

		port {
			panel0_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel0_in>;
	data-lanes = <0 1 2 3>;
	/* 【A：entry9 qcom,platform-te-gpio = tlmm 86；Android 主外部 TE 输入】 */
	qcom,te-source = "mdp_vsync_p";
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l1e_0p88>;
	status = "okay";
};

&pcie0 {
	wake-gpios = <&tlmm 96 GPIO_ACTIVE_HIGH>;
	perst-gpios = <&tlmm 94 GPIO_ACTIVE_LOW>;

	pinctrl-0 = <&pcie0_default_state>;
	pinctrl-names = "default";

	status = "okay";
};

&pcie0_port0 {
	wifi@0 {
		compatible = "pci17cb,1107";
		reg = <0x10000 0x0 0x0 0x0 0x0>;
		qcom,soc-serial-mac-address;

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
	};
};

&pcie0_phy {
	vdda-phy-supply = <&vreg_l1e_0p88>;
	vdda-pll-supply = <&vreg_l3e_1p2>;

	status = "okay";
};

/* 【A：RT pm8550_gpios（0x5bd）display_panel_vddi_default = gpio11 output-high
 *  power-source 1；display_panel_vci_default = gpio1 output-high power-source 0；
 *  volume key = gpio6 pull-up input】 */
&pm8550_gpios {
	display_panel_vddio_default: display-panel-vddio-default-state {
		pins = "gpio11";
		function = "normal";
		power-source = <1>;
		bias-disable;
		output-high;
	};

	display_panel_vci_default: display-panel-vci-default-state {
		pins = "gpio1";
		function = "normal";
		power-source = <0>;
		bias-disable;
		output-high;
	};

		volume_up_n: volume-up-n-state {
		pins = "gpio6";
		function = "normal";
		power-source = <1>;
		bias-pull-up;
		input-enable;
	};
};

/* 【A：RT pm8550b_gpios（0x5ef）display_panel_vddr_default = gpio5 output-high
 *  power-source 1】 */
&pm8550b_gpios {
	display_panel_vdd_default: display-panel-vdd-default-state {
		pins = "gpio5";
		function = "normal";
		power-source = <1>;
		bias-disable;
		output-high;
	};
};

&pm8550_pwm {
	status = "okay";

	power_led {
		color = <LED_COLOR_ID_RGB>;
		label = "power-led";

		#address-cells = <1>;
		#size-cells = <0>;

		red@1 {
			reg = <1>;
			color = <LED_COLOR_ID_RED>;
		};

		green@2 {
			reg = <2>;
			color = <LED_COLOR_ID_GREEN>;
		};

		blue@3 {
			reg = <3>;
			color = <LED_COLOR_ID_BLUE>;
		};
	};
};

&pmk8550 {
	pmk8550_sdam_9d00: nvram@9d00 {
		compatible = "qcom,spmi-sdam";
		reg = <0x9d00>;
	};
};

&pm8550b {
	pm8550b_hv_haptics: qcom,hv-haptics@f000 {
		compatible = "qcom,hv-haptics";

		reg = <0xf000>, <0xf100>, <0xf200>;

		interrupts = <0x07 0xf0 0x01 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "fifo-empty";

		/*
		 * Android:
		 * qcom,vmax-mv-factory = <0x640>;
		 * qcom,vmax-mv-cali    = <0x640>;
		 * qcom,vmax-mv         = <0x2198>;
		 *
		 * 0x640  = 1600 mV
		 * 0x2198 = 8600 mV
		 * 【待捕：entry9 侧 haptics vmax 全族对账 = 震动零设备首查】
		 */
		qcom,vmax-mv-factory = <1600>;
		qcom,vmax-mv-cali = <1600>;
		qcom,vmax-mv = <8600>;

		qcom,brake-mode = <BRAKE_CLOSE_LOOP>;
		qcom,brake-pattern = /bits/ 8 <0xff 0x3f 0x1f>;
		qcom,lra-period-us = <5880>;
		qcom,drv-sig-shape = <WF_SINE>;
		qcom,brake-sig-shape = <WF_SINE>;

		nvmem-names = "hap_cfg_sdam";
		nvmem = <&pmk8550_sdam_9d00>;

		status = "okay";

		hap_swr_slave_reg: qcom,hap-swr-slave-reg {
			regulator-name = "hap-swr-slave-reg";
		};

		effect_0 {
			qcom,effect-id = <0x00>;

			qcom,wf-vmax-mv = <5000>;

			qcom,wf-pattern-data =
				<0x01f 0x00 0x00
				 0x03f 0x00 0x00
				 0x05f 0x00 0x00
				 0x07f 0x00 0x00
				 0x17f 0x00 0x00
				 0x15f 0x00 0x00
				 0x13f 0x00 0x00
				 0x11f 0x00 0x00>;

			qcom,wf-pattern-period-us = <5880>;

			qcom,wf-brake-pattern =
				/bits/ 8 <0x00 0x00 0x00>;

			qcom,wf-pattern-preload;
			qcom,wf-auto-res-disable;
		};

		effect_1 {
			qcom,effect-id = <0x01>;

			qcom,wf-vmax-mv = <5000>;

			qcom,wf-pattern-data =
				<0x01f 0x00 0x00
				 0x03f 0x00 0x00
				 0x05f 0x00 0x00
				 0x07f 0x00 0x00
				 0x17f 0x00 0x00
				 0x15f 0x00 0x00
				 0x13f 0x00 0x00
				 0x11f 0x00 0x00>;

			qcom,wf-pattern-period-us = <5880>;

			qcom,wf-brake-pattern =
				/bits/ 8 <0x00 0x00 0x00>;

			qcom,wf-auto-res-disable;
		};

		effect_2 {
			qcom,effect-id = <0x02>;

			qcom,wf-vmax-mv = <5000>;

			qcom,wf-pattern-data =
				<0x01f 0x00 0x00
				 0x03f 0x00 0x00
				 0x05f 0x00 0x00
				 0x07f 0x00 0x00
				 0x17f 0x00 0x00
				 0x15f 0x00 0x00
				 0x13f 0x00 0x00
				 0x11f 0x00 0x00>;

			qcom,wf-pattern-period-us = <5880>;

			qcom,wf-brake-pattern =
				/bits/ 8 <0x00 0x00 0x00>;

			qcom,wf-auto-res-disable;
		};

		effect_3 {
			qcom,effect-id = <0x03>;

			qcom,wf-vmax-mv = <5000>;

			qcom,wf-pattern-data =
				<0x01f 0x00 0x00
				 0x03f 0x00 0x00
				 0x05f 0x00 0x00
				 0x07f 0x00 0x00
				 0x17f 0x00 0x00
				 0x15f 0x00 0x00
				 0x13f 0x00 0x00
				 0x11f 0x00 0x00>;

			qcom,wf-pattern-period-us = <5880>;

			qcom,wf-brake-pattern =
				/bits/ 8 <0x00 0x00 0x00>;

			qcom,wf-auto-res-disable;
		};

		effect_4 {
			qcom,effect-id = <0x04>;

			qcom,wf-vmax-mv = <5000>;

			qcom,wf-pattern-data =
				<0x01f 0x00 0x00
				 0x03f 0x00 0x00
				 0x05f 0x00 0x00
				 0x07f 0x00 0x00
				 0x17f 0x00 0x00
				 0x15f 0x00 0x00
				 0x13f 0x00 0x00
				 0x11f 0x00 0x00>;

			qcom,wf-pattern-period-us = <5880>;

			qcom,wf-brake-pattern =
				/bits/ 8 <0x00 0x00 0x00>;

			qcom,wf-auto-res-disable;
		};

		effect_5 {
			qcom,effect-id = <0x05>;

			qcom,wf-vmax-mv = <5000>;

			qcom,wf-pattern-data =
				<0x01f 0x00 0x00
				 0x03f 0x00 0x00
				 0x05f 0x00 0x00
				 0x07f 0x00 0x00
				 0x17f 0x00 0x00
				 0x15f 0x00 0x00
				 0x13f 0x00 0x00
				 0x11f 0x00 0x00>;

			qcom,wf-pattern-period-us = <5880>;

			qcom,wf-brake-pattern =
				/bits/ 8 <0x00 0x00 0x00>;

			qcom,wf-auto-res-disable;
		};
	};
};

&pm8550b_eusb2_repeater {
	qcom,tune-usb2-disc-thres = /bits/ 8 <0x6>;
	qcom,tune-usb2-amplitude = /bits/ 8 <0xd>;
	qcom,tune-usb2-preem = /bits/ 8 <0x7>;
	qcom,squelch-detector-bp = <(-3000)>;
	vdd18-supply = <&vreg_l15b_1p8>;
	vdd3-supply = <&vreg_l5b_3p1>;
};

&pmk8550_gpios {
	/* 【A：RT pmk8550 gpio3 sleep-clk（wcn7850-pmu 消费）】 */
	pmk8550_sleep_clk: sleep-clk-state {
		pins = "gpio3";
		function = "func1";
		input-disable;
		output-enable;
		bias-disable;
		power-source = <0>;
	};
};

&pmk8550_rtc {
	nvmem-cells = <&rtc_offset>;
	nvmem-cell-names = "offset";
};

&pmk8550_sdam_2 {
	rtc_offset: rtc-offset@bc {
		reg = <0xbc 0x4>;
	};
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEDOWN>;

	status = "okay";
};

&qupv3_id_0 {
	status = "okay";
};

&remoteproc_adsp {
	firmware-name = "qcom/sm8550/meizu/adsp.mbn",
			"qcom/sm8550/meizu/adsp_dtb.mbn";
	status = "okay";
};

/*
 * Stock assigns the ADSP static-PD (audiopd) remote heap to
 * {LPASS, ADSP_HEAP} and hands a dedicated pool to the DSP.  Without
 * memory-region the fastrpc device has no reserved DMA pool (heap born
 * generic) and without vmids qcom_scm_assign_mem() is skipped, so uAPM
 * never starts.  Shape mirrors upstream sm8250/sm8750.
 */
&{/soc@0/remoteproc@6800000/glink-edge/fastrpc} {
	memory-region = <&adsp_rpc_remote_heap_mem>;
	qcom,vmids = <QCOM_SCM_VMID_LPASS QCOM_SCM_VMID_ADSP_HEAP>;
};

&remoteproc_cdsp {
	firmware-name = "qcom/sm8550/meizu/cdsp.mbn",
			"qcom/sm8550/meizu/cdsp_dtb.mbn";
	status = "okay";
};

&remoteproc_mpss {
	firmware-name = "qcom/sm8550/meizu/modem.mbn",
			"qcom/sm8550/meizu/modem_dtb.mbn";
	status = "okay";
};

/* 【A：RT xo_board clock-frequency = 0x493e000 = 76.8MHz】 */
&sleep_clk {
	clock-frequency = <32764>;
};

&swr1 {
	status = "okay";
	wcd_rx: codec@0,4 {
		compatible = "sdw20217010d00";
		reg = <0 4>;
		qcom,rx-port-mapping = <1 2 3 4 5>;
	};
};

&swr2 {
	status = "okay";
	wcd_tx: codec@0,3 {
		compatible = "sdw20217010d00";
		reg = <0 3>;
		qcom,tx-port-mapping = <2 2 3 4>;
	};
};

&tlmm {
	/* 【D：stock 无 gpio-reserved-ranges 声明；<32 8> = QRD 继承观察项，
	 * 台账 D 类（stock TLMM 全开，SPMI 固有保留由 SoC dtsi 管）】 */
	gpio-reserved-ranges = <32 8>;

	i2s1_default: i2s1-default-state {
		sck-pins {
			pins = "gpio121";
			function = "i2s1_sck";
			drive-strength = <8>;
			bias-disable;
		};

		data0-pins {
			pins = "gpio122";
			function = "i2s1_data0";
			drive-strength = <8>;
			bias-disable;
		};

		ws-pins {
			pins = "gpio123";
			function = "i2s1_ws";
			drive-strength = <8>;
			bias-disable;
		};

		data1-pins {
			pins = "gpio124";
			function = "i2s1_data1";
			drive-strength = <8>;
			bias-disable;
		};
	};

	bt_default: bt-default-state {
		bt-en-pins {
			pins = "gpio81";
			function = "gpio";
			drive-strength = <16>;
			bias-disable;
		};

		sw-ctrl-pins {
			pins = "gpio82";
			function = "gpio";
			bias-pull-down;
		};
	};

	ts_irq: ts-irq-state {
		pins = "gpio25";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	ts_reset: ts-reset-state {
		pins = "gpio24";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	/* 【A：RT sde_dsi_active/suspend = gpio133 ds8 bias-disable / ds2 pull-down】
	 * 注意：本组与 panel reset-gpios=133 同脚（原厂同形——pinctrl 管态、
	 * 面板驱动管电平翻转）。 */
	sde_dsi_active: sde-dsi-active-state {
		pins = "gpio133";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	sde_dsi_suspend: sde-dsi-suspend-state {
		pins = "gpio133";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	sde_te_active: sde-te-active-state {
		pins = "gpio86";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	sde_te_suspend: sde-te-suspend-state {
		pins = "gpio86";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	wcd_default: wcd-reset-n-active-state {
		pins = "gpio108";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-low;
	};

	wlan_en: wlan-en-state {
		pins = "gpio80";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};
};

&uart7 {
	status = "okay";
};

&uart14 {
	status = "okay";

	bluetooth {
		compatible = "qcom,wcn7850-bt";

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;

		max-speed = <3200000>;
		qcom,soc-serial-bd-address;
	};
};

&camss {
	vdda-phy-supply = <&vreg_l1e_0p88>;
	vdda-pll-supply = <&vreg_l3e_1p2>;

	status = "okay";
};

/*
 * Cameras: m2381 四摄全三星（per 本机 dtbo entry9：csiphy/cci 分配见下注），
 * sensor 节点待相机轮（CAMX i2c 地址/上电序在 vendor sensor libs）。
 *   rear  wide   S5KGN5SP03   50MP  csiphy3 cci1 (OIS + AF)
 *   rear  ultra  S5K3P9SX     16MP  csiphy2 cci0 (AF)
 *   rear  depth  S5K5E9YX04    5MP  csiphy1 cci0
 *   front        S5KGD2SP03   32MP  csiphy4 cci1
 * Camera rails = pm8008i/pm8008j LDOs（entry9 侧 pm8008i/j-regulator 在档）。
 */

&ufs_mem_hc {
	/* 【A：RT ufs 节点 reset-gpios = 0xd2 = 210（=硬定律#9 的那根线：UFS 复位，
	 * 勿在他处复用/误标为面板复位）】 */
	reset-gpios = <&tlmm 210 GPIO_ACTIVE_LOW>;
	vcc-supply = <&vreg_l17b_2p5>;
	vcc-max-microamp = <1300000>;
	vccq-supply = <&vreg_l1g_1p2>;
	vccq-max-microamp = <1200000>;
	vdd-hba-supply = <&vreg_l3g_1p2>;

	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l1d_0p88>;
	vdda-pll-supply = <&vreg_l3e_1p2>;

	status = "okay";
};

&usb_1 {
	/* The PMIC GLINK Type-C connector owns the USB data-role switch. */
	dr_mode = "otg";
	usb-psy-name = "qcom-battmgr-usb";

	status = "okay";
};

&usb_1_dwc3_hs {
	remote-endpoint = <&pmic_glink_hs_in>;
};

&usb_1_hsphy {
	phys = <&pm8550b_eusb2_repeater>;

	vdd-supply = <&vreg_l1e_0p88>;
	vdda12-supply = <&vreg_l3e_1p2>;

	status = "okay";
};

&usb_dp_qmpphy {
	vdda-phy-supply = <&vreg_l3f_0p88>;
	vdda-pll-supply = <&vreg_l3e_1p2>;

	mode-switch;

	status = "okay";
};

&usb_dp_qmpphy_out {
	remote-endpoint = <&redriver_ss_in>;
};

/* 【A：RT xo_board = 76.8MHz；sleep_clk 32.764kHz 主线惯例】 */
&xo_board {
	clock-frequency = <76800000>;
};
